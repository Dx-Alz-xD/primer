# Copy this file to .env and fill it in. .env is ignored by git; this file is not,
# so it must never contain a real key.

# Your OpenRouter key: https://openrouter.ai/workspaces/default/keys -> "New key".
OPENROUTER_API_KEY=

# Models to try, in order (free ones end in ":free"). Current free list:
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free,inclusionai/ling-3.2-flash:free,openrouter/free

OPENROUTER_APP_NAME=Primer
OPENROUTER_SITE_URL=http://localhost:5173
