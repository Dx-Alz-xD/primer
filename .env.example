# Copy this file to .env and fill it in. .env is ignored by git; this file is not,
# so it must never contain a real key.

# ---------------------------------------------------------------------
# AI: plans courses, writes lessons, runs the tutor.
# Add a key for at least one provider; every one is optional, and the more
# you add, the more often a lesson gets written when a free model is busy.
# All four have free models.
# ---------------------------------------------------------------------

# Groq: https://console.groq.com/keys (GROQ_API_KEY works too).
GROQ_KEY=
# Google Gemini: https://aistudio.google.com/apikey (GEMINI_API_KEY works too).
GEM_KEY=
# Requesty: https://app.requesty.ai/api-keys (REQUESTY_API_KEY works too).
# Without credit only its free models answer.
REQ_KEY=
# OpenRouter: https://openrouter.ai/workspaces/default/keys -> "New key".
OPENROUTER_API_KEY=

# Which providers to try, in order (this is the default). A provider left out
# of the list isn't used, even if it has a key.
# PRIMER_AI_ORDER=groq,gemini,requesty,openrouter

# Optional: each provider's models, tried in order (a busy or failing one hands
# over to the next). Leave these out to use Primer's tested free defaults:
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GEMINI_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest
# REQUESTY_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b
# OpenRouter's free ones end in ":free". Current list: https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free,inclusionai/ling-3.2-flash:free,openrouter/free

OPENROUTER_APP_NAME=Primer
OPENROUTER_SITE_URL=http://localhost:5173

# Sign-up needs this invite code. Leave it empty (INVITE_CODE=) to let anyone sign up.
INVITE_CODE=PRIMER

# Optional: where the server listens. HOST=0.0.0.0 shares it on your network.
# PORT=5173
# HOST=127.0.0.1

# ElevenLabs: lessons read aloud, sound effects, and speaking a doubt.
# Leave empty to turn voice off (the page then uses quiet built-in tones).
# (EL_LAB_KEY works too.)
ELEVENLABS_API_KEY=
# Optional: another voice (default "George") or model.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Photos in lessons come from Wikimedia Commons. Without contact details Wikimedia
# allows about 10 lookups a minute; add an email or web page of your own to get more.
# WIKIMEDIA_CONTACT=
